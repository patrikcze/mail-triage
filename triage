#!/bin/sh
# ./triage <command>   — runs Mail Triage with the newest Python 3.11+ found on this computer.
root="$(cd "$(dirname "$0")" && pwd)"
for py in python3.14 python3.13 python3.12 python3.11 python3; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
        exec "$py" "$root/triage.py" "$@"
    fi
done
echo "Mail Triage needs Python 3.11 or newer. Install it from https://www.python.org/downloads/macos/" >&2
exit 1
